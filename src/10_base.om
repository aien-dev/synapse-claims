note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note synapse-claims (aien-dev/synapse-claims): append-only, hash-chained, signed lease ledger for AI lanes.
note Unit = om2 line + om/tls/sha2.om + src/*.om (build.sh). This file: capacities, global state, buffered
note output, the string arena, word tables, decimal and hex helpers, die.

const lncap ulong 65536
const ncl ulong 131072
const nf ulong 24
const arcap ulong 33554432
const pecap ulong 8388608
const outcap ulong 524288
const errcap ulong 8192
const socap ulong 1048576
const sicap ulong 1048576
const htmask ulong 262143
const evcap ulong 65536
const tbad ulong 18446744073709551615

note gx cells (scalar state)
const xoutn ulong 0
const xerrn ulong 1
const xsel ulong 2
const xarn ulong 3
const xnc ulong 4
const xseq ulong 5
const xnow ulong 6
const xpkn ulong 7
const xson ulong 8
const xsin ulong 9
const xmfd ulong 10
const xpen ulong 11

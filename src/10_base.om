note word tables: index = position of the space-separated word
note wall: ops 0..4 (code-1), states 5..12 (code+4), kinds 13..17 (code+12), modes 18 excl 19 shared
text wall "claim renew release state expire PROPOSED IMPLEMENTED EXERCISED QUALIFIED MERGED DEPLOYED NOT_RUN BLOCKED repo branch path pr ext excl shared"
text wreason "same_target repo_covers path_overlap ext_casefold"
text wcmds "init claim renew release state who list conflicts verify expire"
text wflags "--home --now --sig-bin --agent --session --target --ttl --mode --state --intent --evidence --import --id --all --agent-prefix"
text wwhy "malformed seq prev hash id signature"

text tpref "synapse-claims: "
text tjerr "{\"ok\":false,\"error\":\""
text tjend "\"}\n"
text ttrue "true"
text tfalse "false"
text mfull "arena full"

note ======== word tables ========

fn tw_off t view uchar * w ulong to ulong
k = ulong 0
p = ulong 0
while lt p len t bound 999999
if eq k w
ret p
end
if eq get t p 32
k = add k 1
end
p = add p 1
end
ret p
end

fn tw_len t view uchar * w ulong to ulong
s = tw_off t w
e = s
while lt e len t bound 999999
if eq get t e 32
ret sub e s
end
e = add e 1
end
ret sub e s
end

note tw_find: index of the word in t[base .. base+cnt) equal to s (whole slice), or tbad
fn tw_find s edit uchar * t view uchar * base ulong cnt ulong to ulong
l = len s
o = ulong 0
for k ulong cnt
w = add base k
p = tw_off t w
if eq tw_len t w l
eqv = true
for i ulong l
if ne get s add o i get t add p i
eqv = false
break
end
end
if eqv
ret w
end
end
end
ret tbad
end

note ======== buffered output: xsel 0 stdout (gout), 1 stderr (gerr) ========

fn o_flush to void
n = get gx xoutn
p = ulong 0
while lt p n bound 999999
w = write 1 gout p sub n p
if le w 0
exit 70
end
p = add p ulong w
end
put gx xoutn 0
end

fn e_flush to void
n = get gx xerrn
p = ulong 0
while lt p n bound 999999
w = write 2 gerr p sub n p
if le w 0
break
end
p = add p ulong w
end
put gx xerrn 0
end

fn o_b c uchar to void
if eq get gx xsel 1
m = get gx xerrn
if lt m errcap
put gerr m c
put gx xerrn add m 1
end
ret
end
if ge get gx xoutn outcap
o_flush
end
n = get gx xoutn
put gout n c
put gx xoutn add n 1
end

fn o_t t view uchar * to void
for i ulong len t
o_b get t i
end
end

fn o_wd t view uchar * w ulong to void
p = tw_off t w
for i ulong tw_len t w
o_b get t add p i
end
end

fn o_ar off ulong n ulong to void
for i ulong n
o_b get gar add off i
end
end

fn o_u v ulong to void
x = v
k = ulong 0
for i ulong 20
put gst i uchar add 48 rem x 10
x = div x 10
k = add k 1
if eq x 0
break
end
end
for j ulong k
o_b get gst sub sub k j 1
end
end

note o_key: writes ,"KEY": (first true: {"KEY":)
fn o_key t view uchar * first bool to void
if first
o_b 123
else
o_b 44
end
o_b 34
o_t t
o_b 34
o_b 58
end

fn o_q to void
o_b 34
end

note die: {"ok":false,"error":"T"} on stdout, `synapse-claims: T` on stderr, exit code
fn die code int t view uchar * to void
o_t tjerr
o_t t
o_t tjend
o_flush
put gx xsel 1
o_t tpref
o_t t
o_b 10
e_flush
exit code
end

note ======== arena ========

fn ar_b c uchar to void
n = get gx xarn
if ge n arcap
die 70 mfull
end
put gar n c
put gx xarn add n 1
end

fn ar_t t view uchar * to ulong
s = get gx xarn
for i ulong len t
ar_b get t i
end
ret s
end

fn ar_ln s edit uchar * off ulong n ulong to ulong
st = get gx xarn
for i ulong n
ar_b get s add off i
end
ret st
end

fn ar_cp off ulong n ulong to ulong
st = get gx xarn
for i ulong n
ar_b get gar add off i
end
ret st
end

fn ar_eq a ulong an ulong b ulong bn ulong to bool
if ne an bn
ret false
end
for i ulong an
if ne get gar add a i get gar add b i
ret false
end
end
ret true
end

fn lower c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end

fn ar_eqci a ulong an ulong b ulong bn ulong to bool
if ne an bn
ret false
end
for i ulong an
if ne lower get gar add a i lower get gar add b i
ret false
end
end
ret true
end

fn hexd v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end

fn hexv c uchar to ulong
if and ge c 48 le c 57
ret ulong sub c 48
end
if and ge c 97 le c 102
ret ulong sub c 87
end
ret 16
end

note sf_ok: 1..256 bytes, each 0x21..0x7e except quote and backslash (identifiers, targets, URLs)
fn sf_ok s edit uchar * to bool
n = len s
if or eq n 0 gt n 256
ret false
end
for i ulong n
c = get s i
if or lt c 33 gt c 126
ret false
end
if or eq c 34 eq c 92
ret false
end
end
ret true
end


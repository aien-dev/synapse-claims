const xkind ulong 45

global gout uchar 524288
global gerr uchar 8192
global gar uchar 33554432
global gcl ulong 3145728
global ght ulong 262144
global ghk ulong 262144
global gpend uchar 8388608
global gpe ulong 8192
global gso uchar 1048576
global gsi uchar 1048576
